# ---------------------------------------------------------------------------
# Manufacturing Cost Intelligence Platform -- environment template
#
#   cp .env.example .env
#
# Values below are DUMMY LOCAL-DEV values only. `.env` is gitignored: real
# secrets are never committed. In Kubernetes they come from Secret
# `mci-secrets`; on AWS from IRSA / Secrets Manager.
# ---------------------------------------------------------------------------

# --- Warehouse (Postgres) -------------------------------------------------
# `postgres` inside docker compose; use `localhost` when running CLIs on the host.
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=mfg_cost
WAREHOUSE_USER=mci
WAREHOUSE_PASSWORD=mci_dev_password
# Host port the compose postgres is published on.
WAREHOUSE_HOST_PORT=5432

# --- Object storage --------------------------------------------------------
# s3://... for MinIO/S3, or a filesystem path (./data/source_drop, ./data/raw)
SOURCE_URI=s3://mci-source
RAW_URI=s3://mci-raw
# MinIO endpoint; leave empty on AWS so boto3 uses real S3.
S3_ENDPOINT_URL=http://minio:9000
# In compose these are also the MinIO root credentials.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-dev-secret
AWS_DEFAULT_REGION=us-east-1

# --- Alerting / logging / close gate --------------------------------------
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO
MATERIALITY_USD=1000

# --- Orchestration ---------------------------------------------------------
EXECUTION_MODE=local
MCI_IMAGE_TAG=0.1.0
K8S_NAMESPACE=mci

# --- Airflow (docker compose only) ----------------------------------------
# Set to `id -u` on Linux so bind-mounted outputs are owned by you.
AIRFLOW_UID=50000
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
# Must match docker/postgres-init/01-airflow-db.sql
AIRFLOW_DB_PASSWORD=airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Dev-only; generate a real one with: python -c "import secrets;print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=dev-only-change-me
