# Copy to k8s/base/secrets.env (gitignored) and fill in. Kustomize's
# secretGenerator turns this into Secret `mci-secrets`.
# Dev values below match the in-cluster MinIO/Postgres; never commit real ones.
WAREHOUSE_PASSWORD=mci_dev_password
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-dev-secret
SLACK_WEBHOOK_URL=
