# Copy to k8s/overlays/prod/secrets.env (gitignored). Prefer External Secrets /
# AWS Secrets Manager in a real deployment; this keeps the demo self-contained.
WAREHOUSE_PASSWORD=<RDS_PASSWORD>
# Left empty on purpose: botocore treats empty env credentials as unset and
# falls through to the IRSA web-identity provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SLACK_WEBHOOK_URL=
